@model UMS.Models.UsersModel

@{
    ViewData["Title"] = "User Details";
}

<h2>@ViewData["title"]</h2>

<div class="card">
    <div class="card-header">
        <h3>User Information</h3>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>User ID:</strong> @Model.Id</p>
                <p><strong>First Name:</strong> @Model.FirstName</p>
                <p><strong>Username:</strong> @Model.Username</p>
                <p><strong>Email:</strong> @Model.Email</p>
            </div>
        </div>
        
        <div class="mt-3">
            <a href="/Users/edituser/@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit"></i> Edit User
            </a>
            <a href="/Users/addusers" class="btn btn-primary">
                <i class="fas fa-user-plus"></i> Add New User
            </a>
            <a href="/Users/getusers" class="btn btn-secondary">
                <i class="fas fa-list"></i> Back to Users
            </a>
            <a href="/" class="btn btn-info">
                <i class="fas fa-home"></i> Back to Home
            </a>
        </div>
    </div>
</div>
