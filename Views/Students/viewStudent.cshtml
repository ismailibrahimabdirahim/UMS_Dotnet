@model UMS.Models.Studentsmodel

@{
    ViewData["Title"] = "Student Details";
}

<h2>@ViewData["title"]</h2>

<div class="card">
    <div class="card-header">
        <h3>Student Information</h3>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>Student ID:</strong> @Model.Id</p>
                <p><strong>Full Name:</strong> @Model.Name</p>
                <p><strong>Batch/Class:</strong> @Model.batch</p>
            </div>
        </div>

        <div class="mt-3">
            <a href="/students/EditStudent/@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit"></i> Edit Student
            </a>
            <a href="/Students/addstudents" class="btn btn-primary">
                <i class="fas fa-user-plus"></i> Add New Student
            </a>
            <a href="/Students/getstudents" class="btn btn-secondary">
                <i class="fas fa-list"></i> Back to Students
            </a>
            <a href="/" class="btn btn-info">
                <i class="fas fa-home"></i> Back to Home
            </a>
        </div>
    </div>
</div>
