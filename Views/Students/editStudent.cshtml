@model UMS.Models.Studentsmodel

@{
    ViewData["Title"] = "Edit Student";
}

<div class="validation-summary" data-valmsg-summary="ModelOnly" class="text-danger mb-3" style="display: none;">
    <ul></ul>
</div>

<h2>Edit Student</h2>

<form asp-action="EditStudent" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Name">Full Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="batch">Batch/Class</label>
        <input asp-for="batch" class="form-control" />
        <span asp-validation-for="batch" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="fas fa-save"></i> Update Student
    </button>
    <a href="/Students/getstudents" class="btn btn-secondary">Cancel</a>
</form>
